{
  "name": "wind-sleep",
  "version": "1.0.0",
  "description": "个人 AI 音乐电台 — Claude reads your taste, plans the sound, plays like a DJ",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "ncm:login": "node server/ncm-login.js",
    "client:dev": "cd client && npx vite --port 5173",
    "client:build": "cd client && npx vite build",
    "build": "npm run client:build",
    "start": "npm run build && node server/index.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "ws": "^8.18.0",
    "node-cron": "^3.0.3"
  }
}
