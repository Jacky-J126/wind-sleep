# Wind Sleep 环境变量示例 — 复制为 .env 后按需填写
# (Copy to .env and fill in as needed)

# ── 服务 / Server ──────────────────────────────────────────
PORT=8888
# 默认只监听本机。如需局域网设备访问改为 0.0.0.0，注意服务无鉴权！
# (Defaults to 127.0.0.1 for safety. The server has no auth — only expose on trusted networks.)
HOST=127.0.0.1

# ── Fish Audio TTS（可选 / optional）───────────────────────
# 不填则 TTS 输出静音占位，全链路仍可走查
# (Without a key, TTS falls back to a silent placeholder)
FISH_AUDIO_KEY=
FISH_AUDIO_VOICE=default

# ── 音源 / Audio source ────────────────────────────────────
# NeteaseCloudMusicApi 地址（默认 http://localhost:3000）
NCM_BASE=http://localhost:3000

# ── 运行时状态（测试/多实例用，可选 / optional）────────────
# WS_STATE_PATH=./state.json
